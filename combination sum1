#include<bits/stdc++.h>
using namespace std;
void com(vector<vector<int>> &v,vector<int> &arr,vector<int> &a,int i,int cursum,int sum)
{
    if(cursum==sum)
    {
        for(int j=0;j<a.size();j++)
        {
            cout<<a[j]<<" ";
        }
        cout<<endl;
        return;
    }
    else if(i==arr.size() || cursum>sum){
        return;
    }
    com(v,arr,a,i+1,cursum,sum);
    if(cursum+arr[i]<=sum)
    {
        a.push_back(arr[i]);
        cursum+=arr[i];
        com(v,arr,a,i,cursum,sum);
        cursum-=arr[i];
        a.pop_back();
    }
    
}
int main(){
    vector<int> arr={2,1,3,7};
    sort(arr.begin(),arr.end());
    vector<vector<int>> v;
    vector<int> a;
    com(v,arr,a,0,0,7);
}
