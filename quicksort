#include<bits/stdc++.h>
using namespace std;
int pp(int arr[],int low,int high)
{
    int pivot=arr[low];
    int i=low;
    int j=high;
    while(i<j)
    {
        while(i<high)
        {
            if(arr[i]<=arr[pivot]) i++;
            else break;
        }
        while(j>low){
            if(arr[j]>arr[pivot]) j--;
            else break;
        }
        if(i<j) swap(arr[i],arr[j]);
        
    }
    swap(arr[pivot],arr[j]);
    return j;
    
}
void quicksort(int arr[],int low,int high)
{
    if(low>=high) return;
    else{
        int pivotINDEX=pp(arr,low,high);
        quicksort(arr,low,pivotINDEX-1);
        quicksort(arr,pivotINDEX+1,high);
    }
}
int main(){
    int arr[]={9,8,7,6,5,1,2,3};
    quicksort(arr,0,7);
    for(int i=0;i<8;i++)
    {
        cout<<arr[i];
    }
}
