#include<bits/stdc++.h>
using namespace std;
void merge(int arr[],int low,int mid,int high)
{
    int n1=mid-low+1;
    int n2=high-mid;
    int arr1[n1],arr2[n2];
    int j=0;
    for(int i=low;i<=mid;i++){
        arr1[j]=arr[i];
        j++;
    }
    j=0;
    for(int i=mid+1;i<=high;i++){
        arr2[j]=arr[i];
        j++;
    }
    j=0;
    int k=0;
    int s=low;
    while(j<n1 && k<n2)
    {
        if(arr1[j]>arr2[k]){ arr[s]=arr1[j];s++;j++;}
        else {arr[s]=arr2[k];s++;k++;}
    }
    while(j<n1)
    {
        arr[s]=arr1[j];s++;j++;
    }
    while(k<n2)
    {
        arr[s]=arr2[k];s++;k++;
    }

}
void mergesort(int arr[],int low,int high)
{
    if(low>=high) return;
    else{
        int mid=low+(high-low)/2;
        mergesort(arr,low,mid);
        mergesort(arr,mid+1,high);
        merge(arr,low,mid,high);
    }
}
int main(){
    int arr[]={9,8,7,6,5,1,2,3};
    mergesort(arr,0,7);
    for(int i=0;i<8;i++)
    {
        cout<<arr[i];
    }
}
