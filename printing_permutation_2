#include<bits/stdc++.h>
using namespace std;
void pp(vector<int>v,vector<vector<int>> &ans,vector<int> &a,vector<int> &b,int i)
{
    if(i==v.size())
    {
        ans.push_back(a);
        for(auto it:a)
        {
            cout<<it<<" ";
        }
        cout<<endl;
        return;
    }
    for(int j=i;j<v.size();j++)
    {
        swap(a[i],a[j]);
        pp(v,ans,a,b,i+1);
        swap(a[i],a[j]);
    }
}
int main()
{
    vector<int> v={1,2,3};
    vector<vector<int>> ans;
    vector<int> a=v;
    vector<int> b(v.size());
    pp(v,ans,a,b,0);
}
