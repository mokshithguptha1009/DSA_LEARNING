#include<bits/stdc++.h>
using namespace std;
void pp(vector<int>v,vector<vector<int>> &ans,vector<int> &a,vector<int> &b,int i)
{
    if(i==v.size())
    {
        ans.push_back(a);
        for(auto it:a)
        {
            cout<<it<<" ";
        }
        cout<<endl;
        return;
    }
    for(int j=0;j<v.size();j++)
    {
        if(b[j]==1) continue;
        b[j]=1;
        a.push_back(v[j]);
        pp(v,ans,a,b,i+1);
        a.pop_back();
        b[j]=0;
    }
}
int main()
{
    vector<int> v={1,2,3,4,5};
    vector<vector<int>> ans;
    vector<int> a;
    vector<int> b(v.size());
    pp(v,ans,a,b,0);
}
